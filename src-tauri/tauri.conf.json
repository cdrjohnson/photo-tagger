{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Photo Tagger",
  "version": "1.0.25",
  "identifier": "com.cdrjohnson.phototagger",
  "build": {
    "beforeDevCommand": "npm run dev:tauri",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build:tauri",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "category": "Photography",
    "shortDescription": "Private on-device photo tagging",
    "longDescription": "Tag and find your photos privately. Library lives in a folder you choose; originals stay on disk."
  },
  "plugins": {}
}
