{
  "name": "photo-tagger",
  "version": "1.0.21",
  "private": true,
  "description": "Private, on-device photo tagging: import photos, auto-tag them with CLIP in the browser, and filter by tag. Installable PWA.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/check-ort.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 4174 --strictPort",
    "typecheck": "tsc --noEmit",
    "labels:embed": "node scripts/embed-labels.mjs",
    "icons": "node scripts/make-icons.mjs",
    "samples": "node scripts/fetch-samples.mjs",
    "test:e2e": "node scripts/e2e.mjs",
    "screenshots": "node scripts/screenshots.mjs",
    "predev": "node scripts/copy-ort.mjs",
    "prebuild": "node scripts/copy-ort.mjs",
    "dev:tauri": "node scripts/copy-ort.mjs && vite",
    "build:tauri": "node scripts/copy-ort.mjs && tsc --noEmit && vite build && node scripts/check-ort.mjs",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "test:unit": "node scripts/unit-storage.mjs && node scripts/unit-tags.mjs",
    "package:portable": "node scripts/package-windows-portable.mjs",
    "test:ort": "node scripts/test-ort.mjs",
    "check:ort": "node scripts/check-ort.mjs"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.2",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-fs": "^2.7.1",
    "@vladmandic/face-api": "^1.7.15",
    "exifr": "^7.1.3",
    "idb": "^8.0.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^5.2.0",
    "acorn": "^8.19.0",
    "playwright": "^1.64.1",
    "sharp": "^0.35.5",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vite-plugin-pwa": "^2.0.0",
    "workbox-window": "^7.4.1"
  }
}
